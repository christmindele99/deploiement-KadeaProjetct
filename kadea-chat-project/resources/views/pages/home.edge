<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Kadea Chat, votre espace de messagerie instantanée. Discutez en privé, échangez en groupe et restez connectés.">
    <title>Kadea Chat - Communiquez sans limites</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Configuration Tailwind -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand-blue': '#075e8d',
                        'brand-accent': '#29ff9d',
                        'brand-dark': '#011c38'
                    }
                }
            }
        }
    </script>

    <!-- Animations personnalisées -->
    <style>
        .reveal {
            opacity: 0;
            transform: translateY(35px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .feature-description {
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transform: translateY(10px);
            transition: all 0.35s ease;
        }

        .feature-card:hover .feature-description {
            opacity: 1;
            max-height: 150px;
            transform: translateY(0);
        }

        @media (hover: none) {
            .feature-description {
                opacity: 1;
                max-height: 150px;
                transform: translateY(0);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .reveal,
            .feature-description,
            .feature-card {
                transition: none;
            }

            .reveal {
                opacity: 1;
                transform: none;
            }
        }
    </style>
</head>

<body class="bg-brand-blue text-white antialiased">

    <!-- ==========================================
         NAVIGATION
    =========================================== -->
    <header class="fixed top-0 left-0 z-50 w-full border-b border-white/10 bg-brand-blue/95 backdrop-blur-xl">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-2 py-4 sm:px-8 lg:px-12">
          <a href="#" class="flex items-center md:gap-2">
              <img src="public/kadea-logo.png" alt="Logo Kadea Chat" class="h-12 w-auto object-contain origin-left scale-150 mr-0 md:mr-3">
              <span class="text-xl font-bold tracking-tight font-['artega',sans-serif]">
                  Kadea<span class="text-brand-accent">Chat</span>
              </span>
          </a>

            <!-- Navigation desktop -->
            <div class="hidden items-center gap-8 md:flex">
                <a href="#fonctionnalites" class="text-sm text-white/80 transition hover:text-brand-accent">Fonctionnalités</a>
                <a href="#comment-ca-marche" class="text-sm text-white/80 transition hover:text-brand-accent">Comment ça marche</a>
                <a href="{{ route('login.show') }}" class="rounded-xl border border-white/20 px-5 py-2.5 text-sm font-semibold transition hover:border-brand-accent hover:text-brand-accent">Se connecter</a>
                <a href="{{ route('register.show') }}" class="rounded-xl bg-brand-accent px-5 py-2.5 text-sm font-semibold text-brand-dark transition hover:opacity-90">Créer un compte</a>
            </div>

            <!-- Navigation mobile -->
            <div class="flex items-center gap-2 md:hidden">
                <a href="{{ route('login.show') }}" class="rounded-lg border border-white/20 px-3 py-2 text-xs font-semibold transition hover:border-brand-accent hover:text-brand-accent">Connexion</a>
                <a href="{{ route('register.show') }}" class="rounded-lg bg-brand-accent px-3 py-2 text-xs font-semibold text-brand-dark transition hover:opacity-90">S'inscrire</a>
            </div>
        </nav>
    </header>

    <!-- ==========================================
         CONTENU PRINCIPAL
    =========================================== -->
    <main>
        <!-- HERO SECTION -->
        <section class="relative flex min-h-screen items-center overflow-hidden px-5 pb-20 pt-32 sm:px-8 lg:px-12">
            <div class="pointer-events-none absolute -right-40 top-20 h-96 w-96 rounded-full bg-brand-accent/10 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-brand-accent/10 blur-3xl"></div>

            <div class="relative mx-auto grid w-full max-w-7xl items-center gap-16 lg:grid-cols-2">
                <!-- Présentation -->
                <div class="reveal">
                    <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-accent/30 bg-brand-accent/10 px-4 py-2 text-xs font-semibold text-brand-accent sm:text-sm">
                        <span class="h-2 w-2 animate-pulse rounded-full bg-brand-accent"></span>
                        Votre espace de communication
                    </span>

                    <h1 class="max-w-2xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
                        Restez connectés,
                        <span class="text-brand-accent">partagez</span>
                        l'essentiel.
                    </h1>

                    <p class="mt-6 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg">
                        Bienvenue sur Kadea Chat, votre espace de messagerie instantanée.
                        Échangez en privé, discutez en groupe et restez proches de ceux qui comptent, où que vous soyez.
                    </p>

                    <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                        <a href="{{ route('login.show') }}" class="flex items-center justify-center gap-2 rounded-xl border border-white/20 px-7 py-4 text-sm font-semibold transition duration-300 hover:border-brand-accent hover:text-brand-accent">
                            Se connecter <span>→</span>
                        </a>
                        <a href="{{ route('register.show') }}" class="flex items-center justify-center gap-2 rounded-xl bg-brand-accent px-7 py-4 text-sm font-bold text-brand-dark shadow-lg shadow-brand-accent/10 transition duration-300 hover:-translate-y-1 hover:opacity-90">
                            Créer un compte <span>→</span>
                        </a>
                    </div>

                    <p class="mt-8 text-xs text-white/50">Simple. Rapide. Connecté.</p>
                </div>

                <!-- Capture réelle de l'interface Kadea Chat -->
                <div class="reveal relative mx-auto w-full max-w-[360px]">
                    <div class="absolute -inset-5 rounded-[2rem] bg-brand-accent/10 blur-2xl"></div>
                    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 shadow-2xl backdrop-blur-xl">
                        <img
                            src="public/clone-whatsapp.png"
                            alt="Capture d'écran de l'interface Kadea Chat montrant la liste des utilisateurs"
                            class="block h-auto w-full object-contain"
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- FONCTIONNALITÉS -->
        <section id="fonctionnalites" class="scroll-mt-24 bg-white/[0.03] px-5 py-24 sm:px-8 lg:px-12">
            <div class="mx-auto max-w-7xl">
                <div class="reveal mx-auto mb-16 max-w-2xl text-center">
                    <span class="text-xs font-bold uppercase tracking-[0.25em] text-brand-accent">Fonctionnalités</span>
                    <h2 class="mt-4 text-3xl font-bold sm:text-4xl">
                        Tout pour mieux <span class="text-brand-accent">communiquer.</span>
                    </h2>
                    <p class="mt-4 text-sm leading-relaxed text-white/60 sm:text-base">
                        Découvrez les outils qui rendent vos conversations plus simples, plus pratiques et plus agréables.
                    </p>
                </div>

                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    <!-- 01 : Messages en temps réel -->
                    <article class="feature-card reveal group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-brand-accent/50 hover:bg-white/[0.08]">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h8m-8 4h5m-9 6 3-3h11a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                        </div>
                        <h3 class="text-lg font-bold transition group-hover:text-brand-accent">01. Message en temps réel</h3>
                        <p class="feature-description mt-3 text-sm leading-relaxed text-white/60">Envoyez et recevez vos messages instantanément. Profitez d'échanges fluides sans avoir à actualiser la page.</p>
                    </article>

                    <!-- 02 : Discussions privées et groupes -->
                    <article class="feature-card reveal group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-brand-accent/50 hover:bg-white/[0.08]">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m12-13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Zm4 4h6m-3-3v6"/></svg>
                        </div>
                        <h3 class="text-lg font-bold transition group-hover:text-brand-accent">02. Discussions privées et groupes</h3>
                        <p class="feature-description mt-3 text-sm leading-relaxed text-white/60">Discutez individuellement avec vos contacts ou créez des groupes pour partager vos idées avec plusieurs personnes.</p>
                    </article>

                    <!-- 03 : Gestion du profil -->
                    <article class="feature-card reveal group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-brand-accent/50 hover:bg-white/[0.08]">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                        </div>
                        <h3 class="text-lg font-bold transition group-hover:text-brand-accent">03. Gestion du profil</h3>
                        <p class="feature-description mt-3 text-sm leading-relaxed text-white/60">Personnalisez votre profil en modifiant votre nom, votre nom d'utilisateur, votre photo et votre biographie.</p>
                    </article>

                    <!-- 04 : Mode sombre et clair -->
                    <article class="feature-card reveal group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-brand-accent/50 hover:bg-white/[0.08]">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v2m0 14v2M3 12h2m14 0h2m-2.64-6.36-1.42 1.42M7.06 16.94l-1.42 1.42m12.72 0-1.42-1.42M7.06 7.06 5.64 5.64M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg>
                        </div>
                        <h3 class="text-lg font-bold transition group-hover:text-brand-accent">04. Mode sombre et clair</h3>
                        <p class="feature-description mt-3 text-sm leading-relaxed text-white/60">Choisissez le thème qui vous convient. Passez du mode clair au mode sombre selon vos préférences.</p>
                    </article>

                    <!-- 05 : Réinitialisation du mot de passe -->
                    <article class="feature-card reveal group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-brand-accent/50 hover:bg-white/[0.08]">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 10v-2a7 7 0 0 1 14 0v2m-7-7v4m-2-2h4"/></svg>
                        </div>
                        <h3 class="text-lg font-bold transition group-hover:text-brand-accent">05. Réinitialisation du mot de passe</h3>
                        <p class="feature-description mt-3 text-sm leading-relaxed text-white/60">Vous avez oublié votre mot de passe ? Retrouvez l'accès à votre compte grâce au processus de réinitialisation.</p>
                    </article>

                    <!-- 06 : Conversations favorites -->
                    <article class="feature-card reveal group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-brand-accent/50 hover:bg-white/[0.08]">
                        <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-accent/10 text-brand-accent">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold transition group-hover:text-brand-accent">06. Mettre une conversation en favoris</h3>
                        <p class="feature-description mt-3 text-sm leading-relaxed text-white/60">
                            Ajoutez vos conversations importantes aux favoris pour les retrouver plus rapidement et accéder facilement à vos échanges préférés.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- COMMENT ÇA MARCHE -->
        <section id="comment-ca-marche" class="scroll-mt-24 px-5 py-24 sm:px-8 lg:px-12">
            <div class="mx-auto max-w-7xl">
                <div class="reveal mx-auto mb-16 max-w-2xl text-center">
                    <span class="text-xs font-bold uppercase tracking-[0.25em] text-brand-accent">Comment ça marche ?</span>
                    <h2 class="mt-4 text-3xl font-bold sm:text-4xl">Trois étapes pour <span class="text-brand-accent">commencer.</span></h2>
                    <p class="mt-4 text-sm leading-relaxed text-white/60 sm:text-base">Rejoignez Kadea Chat et commencez à échanger en quelques instants.</p>
                </div>

                <div class="relative grid gap-10 md:grid-cols-3">
                    <div class="absolute left-[17%] right-[17%] top-8 hidden border-t border-dashed border-brand-accent/40 md:block"></div>

                    <div class="reveal relative text-center">
                        <div class="relative z-10 mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-brand-accent/30 bg-brand-blue text-2xl font-bold text-brand-accent shadow-lg shadow-brand-accent/10">01</div>
                        <h3 class="mt-6 text-xl font-bold">Créer un compte</h3>
                        <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-white/60">Inscrivez-vous gratuitement en renseignant vos informations et créez votre espace personnel.</p>
                    </div>

                    <div class="reveal relative text-center">
                        <div class="relative z-10 mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-brand-accent/30 bg-brand-blue text-2xl font-bold text-brand-accent shadow-lg shadow-brand-accent/10">02</div>
                        <h3 class="mt-6 text-xl font-bold">Rechercher un utilisateur</h3>
                        <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-white/60">Retrouvez facilement les personnes avec lesquelles vous souhaitez communiquer.</p>
                    </div>

                    <div class="reveal relative text-center">
                        <div class="relative z-10 mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-brand-accent/30 bg-brand-blue text-2xl font-bold text-brand-accent shadow-lg shadow-brand-accent/10">03</div>
                        <h3 class="mt-6 text-xl font-bold">Lancer la discussion</h3>
                        <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-white/60">Envoyez votre premier message et profitez pleinement de vos conversations.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- APPEL À L'ACTION FINAL -->
        <section class="px-5 pb-24 pt-10 sm:px-8 lg:px-12">
            <div class="reveal relative mx-auto max-w-7xl overflow-hidden rounded-3xl border border-brand-accent/20 bg-white/5 px-6 py-16 text-center sm:px-12 lg:py-20">
                <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-brand-accent/10 blur-3xl"></div>
                <div class="pointer-events-none absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-brand-accent/10 blur-3xl"></div>

                <div class="relative">
                    <span class="text-xs font-bold uppercase tracking-[0.25em] text-brand-accent">À vous de jouer</span>
                    <h2 class="mx-auto mt-5 max-w-2xl text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
                        Prêt à commencer <span class="text-brand-accent">la conversation ?</span>
                    </h2>
                    <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-white/60 sm:text-base">
                        Rejoignez Kadea Chat dès maintenant et profitez d'une nouvelle expérience de communication.
                    </p>
                    <div class="mt-9 flex flex-col justify-center gap-4 sm:flex-row">
                        <a href="{{ route('login.show') }}" class="rounded-xl border border-white/20 px-8 py-4 text-sm font-semibold transition hover:border-brand-accent hover:text-brand-accent">Se connecter</a>
                        <a href="{{ route('register.show') }}" class="rounded-xl bg-brand-accent px-8 py-4 text-sm font-bold text-brand-dark transition hover:-translate-y-1 hover:opacity-90">Créer un compte</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-white/10 px-5 py-7 sm:px-8 lg:px-12">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 text-center sm:flex-row sm:text-left">
            <span class="text-ls font-bold tracking-tight font-['artega',sans-serif]">
                Kadea<span class="text-brand-accent">Chat</span>
              </span>
            <p class="text-xs text-white/40">© <span id="currentYear"></span> Christ Mindele. Tous droits réservés.</p>
        </div>
    </footer>

    <!-- Fichier JavaScript externe -->
    <script src="/26-01-kd-dev-web-matin-c-mon-thu-kin-capstone-kadea-chat-christmindele99/kadea-chat-project/resources/js/home.js" defer></script>
</body>
</html>
