  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

  {{-- FontAwesome Icons --}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  {{-- Style pour charger la police Artega & Scrollbar --}}
  <style>
    @font-face {
      font-family: 'Artega';
      src: url('/fonts/Artega.woff2') format('woff2'),
           url('/fonts/Artega.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }

    .font-artega {
      font-family: 'Artega', sans-serif;
    }
    
    /* Scrollbar personnalisée */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #29ff9d;
    }
  </style>

  {{-- Tailwind CSS CDN --}}
  <script src="https://cdn.tailwindcss.com"></script>

  {{-- Configuration Tailwind : Polices & Couleurs --}}
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Roboto', 'sans-serif'],
          },
          colors: {
            brand: {
              blue: '#075e8d',
              accent: '#29ff9d',
              dark: '#000000',
              white: '#ffffff',
            }
          }
        }
      }
    }
  </script>
</head>
