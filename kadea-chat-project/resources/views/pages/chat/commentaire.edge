<div class="w-full max-w-2xl mx-auto mb-20">

  {{-- EN-TÊTE --}}

  <div class="mb-6">

    <h3 class="font-artega text-xl font-bold text-brand-blue">
      Commentaire
    </h3>

    <p class="mt-2 text-sm leading-6 text-slate-500">
      Votre avis nous aide à améliorer votre expérience sur Kadea Chat.
    </p>

  </div>


  {{-- FORMULAIRE --}}

  <form id="commentForm" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6">

    {{-- UTILISATEUR --}}

    <div>

      <label class="block text-xs font-semibold text-slate-600 mb-2">
        Votre compte
      </label>

      <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">

        <div class="h-10 w-10 shrink-0 overflow-hidden rounded-full border-2 border-brand-accent bg-white">

          <img
            id="commentUserAvatar"
            src="{{ user.avatar || '/default-avatar.jpg' }}"
            alt="Photo de profil de {{ user.fullName }}"
            class="h-full w-full object-cover"
          >

        </div>

        <div class="min-w-0">

          <p
            id="commentUserName"
            class="truncate text-sm font-semibold text-brand-blue"
          >
            {{ user.fullName }}
          </p>

          <p
            id="commentUsername"
            class="truncate text-xs text-slate-500"
          >
            <span>@</span>{{ user.username }}
          </p>

        </div>

      </div>

    </div>


    {{-- SATISFACTION --}}

    <div>

      <label class="block text-xs font-semibold text-slate-600 mb-3">
        Quel est votre niveau de satisfaction ?
      </label>

      <div
        id="ratingStars"
        class="flex items-center gap-2"
        role="radiogroup"
        aria-label="Évaluer votre satisfaction"
      >

        {{-- ÉTOILE 1 --}}

        <button
          type="button"
          class="rating-star flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 transition-colors hover:border-brand-accent hover:text-brand-accent"
          data-rating="1"
          role="radio"
          aria-label="1 étoile"
          aria-checked="false"
        >
          <i class="fa-solid fa-star text-lg"></i>
        </button>

        {{-- ÉTOILE 2 --}}

        <button
          type="button"
          class="rating-star flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 transition-colors hover:border-brand-accent hover:text-brand-accent"
          data-rating="2"
          role="radio"
          aria-label="2 étoiles"
          aria-checked="false"
        >
          <i class="fa-solid fa-star text-lg"></i>
        </button>

        {{-- ÉTOILE 3 --}}

        <button
          type="button"
          class="rating-star flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 transition-colors hover:border-brand-accent hover:text-brand-accent"
          data-rating="3"
          role="radio"
          aria-label="3 étoiles"
          aria-checked="false"
        >
          <i class="fa-solid fa-star text-lg"></i>
        </button>

        {{-- ÉTOILE 4 --}}

        <button
          type="button"
          class="rating-star flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 transition-colors hover:border-brand-accent hover:text-brand-accent"
          data-rating="4"
          role="radio"
          aria-label="4 étoiles"
          aria-checked="false"
        >
          <i class="fa-solid fa-star text-lg"></i>
        </button>

        {{-- ÉTOILE 5 --}}

        <button
          type="button"
          class="rating-star flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 transition-colors hover:border-brand-accent hover:text-brand-accent"
          data-rating="5"
          role="radio"
          aria-label="5 étoiles"
          aria-checked="false"
        >
          <i class="fa-solid fa-star text-lg"></i>
        </button>

        {{-- ÉTOILE 6 --}}

        <button
          type="button"
          class="rating-star flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-300 transition-colors hover:border-brand-accent hover:text-brand-accent"
          data-rating="6"
          role="radio"
          aria-label="6 étoiles"
          aria-checked="false"
        >
          <i class="fa-solid fa-star text-lg"></i>
        </button>

      </div>

      <p
        id="ratingDescription"
        class="mt-2 text-[11px] text-slate-400"
      >
        Sélectionnez une note de 1 à 6 étoiles.
      </p>

      <input
        type="hidden"
        id="ratingInput"
        name="rating"
        value=""
      >

    </div>


    {{-- COMMENTAIRE --}}

    <div>

      <label
        for="commentInput"
        class="block text-xs font-semibold text-slate-600 mb-2"
      >
        Votre commentaire
      </label>

      <textarea
        id="commentInput"
        name="comment"
        rows="6"
        maxlength="1000"
        placeholder="Partagez votre expérience, vos suggestions ou les difficultés que vous avez rencontrées..."
        class="w-full resize-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-brand-blue placeholder:text-slate-400 focus:border-brand-accent focus:outline-none focus:ring-1 focus:ring-brand-accent"
      ></textarea>

      <div class="mt-1 flex justify-end">

        <span
          id="commentCounter"
          class="text-[11px] text-slate-400"
        >
          0 / 1000
        </span>

      </div>

    </div>


    {{-- ACTIONS --}}

    <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">

      <button
        type="button"
        id="cancelCommentButton"
        class="rounded-xl border border-slate-200 px-5 py-2.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-50"
      >
        Annuler
      </button>

      <button
        type="submit"
        id="sendCommentButton"
        class="rounded-xl bg-brand-blue px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-sky-800"
      >
        Envoyer
      </button>

    </div>

  </form>

</div>