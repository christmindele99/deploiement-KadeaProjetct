            type="button"
            id="changePasswordButton"
            class="flex-1 flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-brand-blue hover:bg-emerald-50 transition-colors"
          >
            <i class="fa-solid fa-key text-xs"></i>
            Modifier le mot de passe
          </button>

          
        <button
          type="button"
          id="resetPasswordButton"
          class="flex-1 flex items-center justify-center gap-2 rounded-xl border border-[#075e8d] bg-[#075e8d] px-4 py-2.5 text-xs font-semibold text-white hover:bg-[#064b70] transition-colors"
        >
          <i class="fa-solid fa-rotate-right text-xs"></i>
          Réinitialiser le mot de passe
        </button>


        </div>

      </div>

    </div>
  </main>


