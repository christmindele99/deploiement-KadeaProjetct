<body class="h-full bg-white font-sans text-brand-blue antialiased flex flex-row overflow-hidden relative">

  {{-- NAVIGATION DESKTOP --}}

  <aside class="app-panel hidden w-20 shrink-0 flex-col items-center justify-between border-r border-slate-200 bg-white py-6 md:flex">

    <div class="flex w-full flex-col items-center gap-9">

      <div class="flex w-full justify-center">
        <img
          src="/kadea-logo.png"
          alt="Logo Kadea Chat"
          class="h-15 w-15 scale-150 object-contain"
        >
      </div>

      <nav class="flex w-full flex-col items-center gap-5" aria-label="Navigation principale">

        <a
          href="/chat"
          title="Chats"
          aria-label="Chats"
          class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/chat' ? 'bg-brand-accent text-brand-blue' : '' }}"
        >
          <i class="fa-solid fa-comment-dots text-lg"></i>
        </a>

        <a
          href="/users"
          title="Utilisateurs"
          aria-label="Utilisateurs"
          id="usersButton"
          class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/users' ? 'bg-brand-accent text-brand-blue' : '' }}"
        >
          <i class="fa-solid fa-user-group text-lg"></i>
        </a>

        <a
          href="/groups"
          title="Groupes"
          aria-label="Groupes"
          id="groupsButton"
          class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/groups' ? 'bg-brand-accent text-brand-blue' : '' }}"
        >
          <i class="fa-solid fa-users text-lg"></i>
        </a>

      </nav>
    </div>

    <div class="flex flex-col items-center gap-5">

      <a
        href="/settings"
        title="Paramètres"
        aria-label="Paramètres"
        id="settingsButton"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/settings' ? 'bg-brand-accent text-brand-blue' : '' }}"
      >
        <i class="fa-solid fa-gear text-lg"></i>
      </a>

      <a
        href="/profile"
        title="Mon profil"
        aria-label="Mon profil"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/profile' ? 'bg-brand-accent text-brand-blue' : '' }}"
      >
        <img
          src="{{ user.avatar || '/default-avatar.jpg' }}"
          alt="Photo de profil de {{ user.fullName }}"
          class="h-10 w-10 rounded-full border-2 border-brand-accent object-cover"
        >
      </a>

    </div>
  </aside>


  {{-- ZONE PRINCIPALE --}}

  <main id="mainPanel" class="relative flex min-w-0 flex-1 flex-col bg-white overflow-y-auto">

    <header class="sticky top-0 z-20 flex h-[76px] shrink-0 items-center justify-between border-b border-slate-200 bg-white px-6 lg:px-8">

      <div class="flex items-center gap-3">

        <a
          href="/settings"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-brand-blue hover:bg-emerald-50 md:hidden"
          aria-label="Retour aux paramètres"
        >
          <i class="fa-solid fa-arrow-left"></i>
        </a>

        <h2 class="font-artega text-xl font-bold text-brand-blue">
          Confidentialité
        </h2>

      </div>
    </header>


    <div class="flex-1 px-4 py-6 sm:px-8 lg:px-12 max-w-3xl w-full mx-auto space-y-6 pb-28 md:pb-10">

      {{-- MESSAGE DE RETOUR --}}

      <div
        id="passwordMessage"
        class="hidden rounded-xl border px-4 py-3 text-sm"
        role="alert"
        aria-live="polite"
      ></div>


      {{-- SÉCURITÉ --}}

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">

        <h4 class="text-sm font-bold text-brand-blue flex items-center gap-2 border-b border-slate-100 pb-4">
