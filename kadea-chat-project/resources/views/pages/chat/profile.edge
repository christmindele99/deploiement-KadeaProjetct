  @include('components/fonts')
  @include('components/style')
</head>

<body class="h-full bg-white font-sans text-brand-blue antialiased flex flex-row overflow-hidden relative">

  {{-- NAVIGATION DESKTOP --}}

  <aside class="app-panel hidden w-20 shrink-0 flex-col items-center justify-between border-r border-slate-200 bg-white py-6 md:flex">

    <div class="flex w-full flex-col items-center gap-9">

      <div class="flex w-full justify-center">
        <img
          src="/kadea-logo.png"
          alt="Logo Kadea Chat"
          class="h-15 w-15 scale-150 object-contain"
        >
      </div>

      <nav class="flex w-full flex-col items-center gap-5" aria-label="Navigation principale">

        <a
          href="/chat"
          title="Chats"
          aria-label="Chats"
          class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/chat' ? 'bg-brand-accent text-brand-blue' : '' }}"
        >
          <i class="fa-solid fa-comment-dots text-lg"></i>
        </a>

        <a
          href="/chat#users"
          data-section="users"
          title="Utilisateurs"
          aria-label="Utilisateurs"
          id="usersButton"
          class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4]"
        >
          <i class="fa-solid fa-user-group text-lg"></i>
        </a>

      </nav>
    </div>

    <div class="flex flex-col items-center gap-5">

      <a
        href="/settings"
        title="Paramètres"
        aria-label="Paramètres"
        id="settingsButton"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/settings' ? 'bg-brand-accent text-brand-blue' : '' }}"
      >
        <i class="fa-solid fa-gear text-lg"></i>
      </a>

      <a
        href="/profile"
        title="Mon profil"
        aria-label="Mon profil"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/profile' ? 'bg-brand-accent text-brand-blue' : '' }}"
      >
        <img
          src="{{ user.avatar || '/default-avatar.jpg' }}"
          alt="Photo de profil de {{ user.fullName }}"
          class="h-10 w-10 rounded-full border-2 border-brand-accent object-cover"
        >
      </a>

    </div>
  </aside>


  {{-- ZONE PRINCIPALE --}}

  <main id="mainPanel" class="relative flex min-w-0 flex-1 flex-col bg-white overflow-y-auto">

    <header class="sticky top-0 z-20 flex h-[76px] shrink-0 items-center justify-between border-b border-slate-200 bg-white px-6 lg:px-8">

      <div class="flex items-center gap-3">

        <a
          href="/settings"
          class="flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-brand-blue hover:bg-emerald-50 md:hidden"
          aria-label="Retour aux paramètres"
        >
          <i class="fa-solid fa-arrow-left"></i>
        </a>

        <h2 class="font-artega text-xl font-bold text-brand-blue">
          Modifier le profil
        </h2>

      </div>
    </header>


    <div class="flex-1 px-4 py-6 sm:px-8 lg:px-12 max-w-3xl w-full mx-auto space-y-6 pb-28 md:pb-10">

      {{-- MESSAGE DE RETOUR --}}

      <div
        id="profileMessage"
        class="hidden rounded-xl border px-4 py-3 text-sm"
        role="alert"
        aria-live="polite"
      ></div>


      {{-- EN-TÊTE DU PROFIL --}}

      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 rounded-2xl bg-brand-blue p-6 shadow-sm text-white">

        <div class="relative group">

          <div class="h-24 w-24 sm:h-28 sm:w-28 rounded-full overflow-hidden border-2 border-brand-accent/40 bg-white/10 flex items-center justify-center shadow-inner">

            <img
              id="avatarPreview"
              src="{{ user.avatar || '/default-avatar.jpg' }}"
              alt="Photo de profil de {{ user.fullName }}"
              class="h-full w-full object-cover rounded-full"
            >

          </div>

          <label
            for="avatarInput"
            class="absolute -bottom-2 -right-2 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-brand-accent text-brand-blue font-bold shadow-md hover:bg-emerald-300 transition-colors"
            title="Modifier la photo"
          >
            <i class="fa-solid fa-camera text-xs"></i>
          </label>

          <input
            type="file"
            id="avatarInput"
            class="hidden"
            accept="image/*"
          >

        </div>


        <div class="flex-1 text-center sm:text-left space-y-1">

          <h3 id="profileFullName" class="text-lg font-bold text-brand-accent">
            {{ user.fullName }}
          </h3>

          <p id="profileUsername" class="text-xs font-medium text-blue-100">
            <span>@</span>{{ user.username }}
          </p>

          <p class="text-[11px] text-blue-200/80">
            Membre depuis le
            {{ user.createdAt.setLocale('fr').toFormat('d MMMM yyyy') }}
          </p>

          <p id="profileBio" class="text-xs text-white/90 mt-2 leading-relaxed">
            {{ user.bio || 'Aucune biographie renseignée.' }}
          </p>

        </div>
      </div>


      {{-- INFORMATIONS PERSONNELLES --}}

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-5">

        <div class="flex items-center justify-between border-b border-slate-100 pb-4">

          <h4 class="text-sm font-bold text-brand-blue flex items-center gap-2">
            <i class="fa-solid fa-user text-brand-accent"></i>
            Informations personnelles
          </h4>

          <button
            type="button"
            id="editProfileButton"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-brand-blue hover:bg-emerald-50 transition-colors"
            title="Modifier le profil"
            aria-label="Modifier le profil"
            aria-pressed="false"
          >
            <i id="editIcon" class="fa-solid fa-pen text-xs"></i>
          </button>

        </div>


        <form id="profileForm" class="space-y-4">

          {{-- NOM COMPLET --}}

          <div>
            <label for="fullnameInput" class="block text-xs font-semibold text-slate-600 mb-1">
              Nom complet
            </label>

            <input
              type="text"
              id="fullnameInput"
              name="fullName"
              value="{{ user.fullName }}"
              disabled
              required
              minlength="2"
              autocomplete="name"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-brand-blue disabled:opacity-80 focus:border-brand-accent focus:bg-white focus:outline-none transition-colors"
            >
          </div>


          {{-- NOM D'UTILISATEUR --}}

          <div>
            <label for="usernameInput" class="block text-xs font-semibold text-slate-600 mb-1">
              Nom d'utilisateur
            </label>

            <div class="relative">

              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm">
                @
              </span>

              <input
                type="text"
                id="usernameInput"
                name="username"
                value="{{ user.username }}"
                disabled
                required
                minlength="3"
                autocomplete="username"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 pl-8 pr-4 py-2.5 text-sm text-brand-blue disabled:opacity-80 focus:border-brand-accent focus:bg-white focus:outline-none transition-colors"
              >

            </div>

            <p class="mt-1 text-[11px] text-slate-400">
              Votre nom d'utilisateur identifie votre compte.
            </p>
          </div>


          {{-- EMAIL --}}

          <div>
            <label for="emailInput" class="block text-xs font-semibold text-slate-600 mb-1">
              Adresse email
            </label>

            <input
              type="email"
              id="emailInput"
              value="{{ user.email }}"
              disabled
              autocomplete="email"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-brand-blue disabled:opacity-80 focus:outline-none cursor-not-allowed"
            >
          </div>


          {{-- BIOGRAPHIE --}}

          <div>
            <label for="bioInput" class="block text-xs font-semibold text-slate-600 mb-1">
              Biographie
            </label>

            <textarea
              id="bioInput"
              name="bio"
              rows="3"
              disabled
              maxlength="500"
              placeholder="Présentez-vous en quelques mots..."
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-brand-blue disabled:opacity-80 focus:border-brand-accent focus:bg-white focus:outline-none resize-none transition-colors"
            >{{ user.bio || '' }}</textarea>
          </div>


          {{-- STATUT DU COMPTE --}}

          <div class="flex items-center justify-between pt-2">

            <span class="text-xs font-medium text-slate-600">
              Statut du compte
            </span>

            @if(user.emailVerifiedAt)
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600 border border-emerald-200">
                <i class="fa-solid fa-circle-check text-[10px]"></i>
                Compte vérifié
              </span>
            @else
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-600 border border-amber-200">
                <i class="fa-solid fa-circle-exclamation text-[10px]"></i>
                Email non vérifié
              </span>
            @endif

          </div>


          {{-- ACTIONS D'ÉDITION --}}

          <div id="saveActions" class="hidden justify-end gap-3 pt-3">

            <button
              type="button"
              id="cancelEditButton"
              class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"
            >
              Annuler
            </button>

            <button
              type="submit"
              id="saveProfileButton"
              class="rounded-xl bg-brand-blue px-5 py-2 text-xs font-semibold text-white hover:bg-sky-800 shadow-md disabled:opacity-60"
            >
              Enregistrer les modifications
            </button>

          </div>

        </form>
      </div>

    </div>
  </main>


  {{-- NAVIGATION MOBILE --}}

  <nav
    id="mobileNavigation"
    class="app-panel mobile-glass fixed inset-x-3 bottom-[10px] z-30 flex min-h-[68px] items-center justify-around rounded-[26px] border border-slate-200 bg-white/90 px-2 py-[7px] shadow-[0_8px_30px_rgba(0,0,0,0.10)] backdrop-blur-xl md:hidden"
    aria-label="Navigation mobile"
  >

    <a
      href="/chat"
      title="Chats"
      aria-label="Chats"
      class="mobile-nav-item relative flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px] text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/chat' ? 'bg-brand-accent text-brand-blue font-bold' : '' }}"
    >
      <i class="fa-solid fa-comment-dots text-xl"></i>
    </a>

    <a href="/chat"
      id="mobileBack"
      aria-label="Retour"
      title="Retour"
      class="flex h-[52px] w-[52px] shrink-0 -translate-y-2 items-center justify-center rounded-full bg-brand-blue text-white shadow-[0_5px_14px_rgba(7,94,141,0.25)] transition-colors duration-200 hover:bg-sky-800">

      <i class="fa-solid fa-arrow-left text-xl"></i>
    </a>

    <a
      href="/settings"
      title="Paramètres"
      aria-label="Paramètres"
      class="mobile-nav-item relative flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px] text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/settings' ? 'bg-brand-accent text-brand-blue font-bold' : '' }}"
    >
      <i class="fa-solid fa-gear text-xl"></i>
    </a>

  </nav>
  @vite(['resources/js/chat/profile.js'])
</body>
</html>
