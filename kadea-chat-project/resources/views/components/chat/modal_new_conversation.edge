{{-- MODALE : NOUVELLE CONVERSATION --}}
<div id="newChatModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
  <section role="dialog" aria-modal="true" aria-labelledby="newChatTitle" class="app-panel w-full max-w-md rounded-2xl bg-white p-5 shadow-xl">
    <div class="mb-5 flex items-center justify-between gap-3">
      <h2 id="newChatTitle"
        class="font-artega text-xl font-bold text-brand-blue">
        Nouvelle conversation
      </h2>
      <button type="button" id="closeNewChat"
        aria-label="Fermer"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4]">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>
    </div>

    <button type="button" id="createGroupButton"
      class="mb-4 flex w-full items-center gap-3 rounded-xl border border-slate-200 p-3 text-left transition hover:bg-emerald-50">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-accent text-black">
        <i class="fa-solid fa-users"></i>
      </span>
      <span>
        <span class="block text-sm font-semibold text-brand-blue">
          Créer un groupe
        </span>
        <span class="block text-xs text-slate-500">
          Démarrer une discussion à plusieurs
        </span>
      </span>
    </button>

    <p class="mb-3 text-sm font-semibold text-brand-blue">
      Démarrer une discussion
    </p>

    <input id="contactSearch" type="search"
      placeholder="Rechercher un contact..."
      aria-label="Rechercher un contact"
      class="app-input mb-3 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm">

    <div id="newChatContacts"
      class="max-h-64 space-y-1 overflow-y-auto"></div>
  </section>
</div>


{{-- MODALE : CRÉER UN GROUPE --}}
<div id="createGroupModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
  <section role="dialog" aria-modal="true" aria-labelledby="createGroupTitle" class="app-panel flex max-h-[90vh] w-full max-w-md flex-col rounded-2xl bg-white p-5 shadow-xl">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 id="createGroupTitle" class="font-artega text-xl font-bold text-brand-blue">
        Créer un groupe
      </h2>
      <button type="button" id="closeCreateGroup" aria-label="Fermer"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4]">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>
    </div>

    <input id="groupName" type="text" maxlength="100" placeholder="Nom du groupe"
      aria-label="Nom du groupe"
      class="app-input mb-3 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none">

    <textarea id="groupDescription" rows="2" maxlength="255" placeholder="Description (facultatif)"
      aria-label="Description du groupe"
      class="app-input mb-3 w-full resize-none rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none"></textarea>

    <input id="groupMemberSearch" type="search" placeholder="Rechercher un utilisateur..."
      aria-label="Rechercher un utilisateur"
      class="app-input mb-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none">

    <p class="mb-2 text-xs text-slate-500">
      <span id="groupSelectedCount">0</span> membre(s) sélectionné(s)
    </p>

    <div id="groupMembersList" class="min-h-0 flex-1 space-y-1 overflow-y-auto"></div>

    <p id="createGroupError" role="alert"
      class="mt-3 hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"></p>

    <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <button type="button" id="cancelCreateGroup"
        class="inline-flex min-h-10 items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
        Annuler
      </button>
      <button type="button" id="confirmCreateGroup" disabled
        class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-brand-accent px-4 py-2.5 text-sm font-semibold text-black transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-50">
        <i class="fa-solid fa-users" aria-hidden="true"></i>
        <span>Créer le groupe</span>
      </button>
    </div>
  </section>
</div>


{{-- MODALE : INFOS DU GROUPE --}}
<div id="groupInfoModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
  <section role="dialog" aria-modal="true" aria-labelledby="groupInfoName" class="app-panel flex max-h-[90vh] w-full max-w-md flex-col rounded-2xl bg-white p-5 shadow-xl">

    {{-- EN-TÊTE --}}
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 class="font-artega text-xl font-bold text-brand-blue">
        Infos du groupe
      </h2>

      <div class="flex items-center gap-1">

        {{-- MENU ADMIN (3 points) --}}
        <div id="groupInfoMenuWrapper" class="relative hidden">
          <button type="button" id="groupInfoMenuButton" aria-label="Options du groupe" aria-haspopup="true"
            class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4]">
            <i class="fa-solid fa-ellipsis-vertical text-xl"></i>
          </button>

          <div id="groupInfoMenu"
            class="absolute right-0 top-full z-10 mt-1 hidden w-64 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg">
            <button type="button" data-group-action="edit-info"
              class="flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left text-sm text-slate-700 transition hover:bg-slate-50 hover:text-brand-blue">
              <i class="fa-solid fa-pen w-5 text-center text-brand-blue"></i>
              <span>Modifier le nom et la description</span>
            </button>

            <button type="button" data-group-action="add-admin"
              class="flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left text-sm text-slate-700 transition hover:bg-slate-50 hover:text-brand-blue">
              <i class="fa-solid fa-user-plus w-5 text-center text-brand-blue"></i>
              <span>Ajouter un membre</span>
            </button>

            <button type="button" data-group-action="remove-member"
              class="flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left text-sm text-slate-700 transition hover:bg-slate-50 hover:text-brand-blue">
              <i class="fa-solid fa-user-minus w-5 text-center text-brand-blue"></i>
              <span>Retirer un membre</span>
            </button>

            <button type="button" data-group-action="delete-group"
              class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm text-slate-700 transition hover:bg-red-50 hover:text-red-600">
              <i class="fa-solid fa-trash-can w-5 text-center text-red-500"></i>
              <span>Supprimer le groupe</span>
            </button>
          </div>
        </div>

        {{-- FERMER --}}
        <button type="button" id="closeGroupInfo" aria-label="Fermer"
          class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4]">
          <i class="fa-solid fa-xmark text-xl"></i>
        </button>

      </div>
    </div>

    {{-- PHOTO, NOM ET DESCRIPTION --}}
<div class="flex flex-col items-center text-center">
    <div class="relative">
      {{-- PHOTO OU INITIALES DU GROUPE --}}
      <div id="groupInfoAvatar"
        class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-full bg-[#29ff9d] text-2xl font-semibold text-[#075e8d]">
      </div>

      {{-- ICÔNE SUPERPOSÉE SUR LE CERCLE --}}
      <button
        type="button"
        id="changeGroupAvatarButton"
        aria-label="Modifier la photo du groupe"
        title="Modifier la photo du groupe"
        class="absolute bottom-0 right-0 flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-brand-blue text-white shadow-md transition hover:brightness-110">
        <i class="fa-solid fa-camera text-sm text-white"></i>
      </button>
    </div>

    <h3 id="groupInfoName"
      class="mt-3 break-words text-lg font-bold text-brand-blue"></h3>

    <p id="groupInfoDescription"
      class="mt-1 break-words text-sm text-slate-500"></p>
  </div>

      <div id="groupInfoMembersSection" class="flex min-h-0 flex-1 flex-col">

      {{-- MEMBRES --}}
      <div class="mt-5 border-t border-slate-100 pt-4">
        <p class="mb-2 text-sm font-semibold text-brand-blue">
          Membres (<span id="groupInfoMembersCount">0</span>)
        </p>

        <input id="groupInfoSearch" type="search" placeholder="Rechercher un membre..."
          aria-label="Rechercher un membre"
          class="app-input mb-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none">
      </div>

      <div id="groupInfoMembers" class="min-h-0 flex-1 space-y-1 overflow-y-auto"></div>

    </div>
    
    {{-- AJOUTER DES MEMBRES --}}
    <div id="addMembersSection" class="mt-5 hidden min-h-0 flex-1 flex-col border-t border-slate-100 pt-4">
      <p class="mb-2 text-sm font-semibold text-brand-blue">
        Ajouter des membres
        (<span id="addMembersSelectedCount">0</span> sélectionné(s))
      </p>

      <input id="addMembersSearch" type="search" placeholder="Rechercher un utilisateur..."
        aria-label="Rechercher un utilisateur à ajouter"
        class="app-input mb-2 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none">

      <div id="addMembersList" class="min-h-0 flex-1 space-y-1 overflow-y-auto"></div>

      <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" id="cancelAddMembers"
          class="inline-flex min-h-10 items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
          Annuler
        </button>
        <button type="button" id="confirmAddMembers" disabled
          class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-brand-accent px-4 py-2.5 text-sm font-semibold text-black transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-50">
          <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
          <span>Ajouter</span>
        </button>
      </div>
    </div>

    <p id="groupInfoError" role="alert"
      class="mt-3 hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"></p>
  </section>
</div>

{{-- MODALE : MODIFIER LE NOM ET LA DESCRIPTION --}}
<div id="editGroupModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/40 p-4">
  <section role="dialog" aria-modal="true" aria-labelledby="editGroupTitle" class="app-panel w-full max-w-md rounded-2xl bg-white p-5 shadow-xl">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 id="editGroupTitle" class="font-artega text-xl font-bold text-brand-blue">
        Modifier le groupe
      </h2>
      <button type="button" id="closeEditGroup" aria-label="Fermer"
        class="nav-item flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-brand-blue transition duration-200 hover:bg-[#e8fff4]">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>
    </div>

    <label for="editGroupName" class="mb-1 block text-xs font-semibold text-slate-600">
      Nom du groupe
    </label>
    <input id="editGroupName" type="text" maxlength="100"
      class="app-input mb-3 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none">

    <label for="editGroupDescription" class="mb-1 block text-xs font-semibold text-slate-600">
      Description
    </label>
    <textarea id="editGroupDescription" rows="3" maxlength="255"
      class="app-input w-full resize-none rounded-xl border border-slate-200 bg-white p-3 text-sm focus:border-brand-blue focus:outline-none"></textarea>

    <p id="editGroupError" role="alert"
      class="mt-3 hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"></p>

    <div class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <button type="button" id="cancelEditGroup"
        class="inline-flex min-h-10 items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
        Annuler
      </button>
      <button type="button" id="saveEditGroup" disabled
        class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-brand-accent px-4 py-2.5 text-sm font-semibold text-black transition hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-50">
        <span>Enregistrer</span>
      </button>
    </div>
  </section>
</div>