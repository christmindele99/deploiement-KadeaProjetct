<nav id="mobileNavigation"
  class="app-panel mobile-glass fixed inset-x-3 bottom-[10px] z-30 flex min-h-[68px] items-center justify-around rounded-[26px] border border-slate-200 bg-white/90 px-2 py-[7px] shadow-[0_8px_30px_rgba(0,0,0,0.10)] backdrop-blur-xl md:hidden"
  aria-label="Navigation mobile">

  <a href="/chat"
    data-section="chats"
    title="Chats"
    aria-label="Chats"
    class="mobile-nav-item relative flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px] text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/chat' ? 'bg-brand-accent text-brand-blue font-bold' : '' }}">
    <i class="fa-solid fa-comment-dots text-xl"></i>
  </a>

  <button type="button" id="mobileNewChat"
    aria-label="Nouvelle conversation"
    title="Nouvelle conversation"
    class="mobile-new-chat -translate-y-2 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-blue text-white shadow-[0_8px_22px_rgba(7,94,141,0.24)] transition duration-200 hover:-translate-y-[10px]">
    <i class="fa-solid fa-plus text-xl"></i>
  </button>


  <a href="/settings"
    data-section="settings"
    title="Paramètres"
    aria-label="Paramètres"
    class="mobile-nav-item relative flex h-11 w-11 shrink-0 items-center justify-center rounded-[14px] text-brand-blue transition duration-200 hover:bg-[#e8fff4] {{ request.url() === '/settings' ? 'bg-brand-accent text-brand-blue font-bold' : '' }}">
    <i class="fa-solid fa-gear text-xl"></i>
  </a>
</nav>