 <section
  id="conversationList"
  class="app-panel flex min-h-0 w-full shrink-0 flex-col border-r-0 border-slate-200 bg-white md:w-80 md:border-r lg:w-96"
>
  {{-- EN-TÊTE --}}
  <div class="space-y-4 p-4 pb-3 sm:p-5">

    <div class="flex items-center justify-between gap-3">
      <h1 class="font-artega text-2xl font-bold tracking-wide text-brand-blue">
        Conversations
      </h1>

      <button
        type="button"
        id="openNewChat"
        aria-label="Démarrer une conversation ou créer un groupe"
        title="Nouvelle conversation"
        class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl text-brand-blue transition hover:bg-brand-accent hover:text-black md:flex"
      >
        <i class="fa-solid fa-pen-to-square text-lg"></i>
      </button>
    </div>

    {{-- RECHERCHE --}}
    <div class="relative">
      <i
        class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-brand-blue/60"
      ></i>

      <input
        id="chatSearch"
        type="search"
        placeholder="Rechercher une discussion..."
        aria-label="Rechercher une discussion"
        class="app-input w-full rounded-full border border-slate-200 bg-white py-3 pl-10 pr-4 text-sm text-brand-blue placeholder-slate-400 focus:border-brand-blue focus:outline-none"
      >
    </div>

    {{-- FILTRES --}}
    <div
      class="no-scrollbar flex items-center gap-2 overflow-x-auto py-1"
      aria-label="Filtrer les conversations"
    >
      <button
        type="button"
        data-chat-filter="all"
        aria-pressed="true"
        class="filter-button is-active shrink-0 rounded-full border border-transparent px-[15px] py-[9px] text-xs font-medium transition"
      >
        Tous
      </button>

      <button
        type="button"
        data-chat-filter="unread"
        aria-pressed="false"
        class="filter-button shrink-0 rounded-full border border-transparent px-[15px] py-[9px] text-xs font-medium transition"
      >
        Non lus
      </button>

      <button
        type="button"
        data-chat-filter="groups"
        aria-pressed="false"
        class="filter-button shrink-0 rounded-full border border-transparent px-[15px] py-[9px] text-xs font-medium transition"
      >
        Groupes
      </button>

      <button
        type="button"
        data-chat-filter="favorites"
        aria-pressed="false"
        class="filter-button shrink-0 rounded-full border border-transparent px-[15px] py-[9px] text-xs font-medium transition"
      >
        Favoris
      </button>
    </div>

    {{-- BARRE DE SÉLECTION MULTIPLE --}}
    <div
      id="conversationSelectionHeader"
      class="hidden items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-3"
    >
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold text-brand-blue">
          Sélection des conversations
        </p>

        <p class="mt-0.5 text-xs text-slate-500">
          <span id="conversationSelectionCount">0</span>
          conversation(s) sélectionnée(s)
        </p>
      </div>

      {{-- ACTIONS DE SÉLECTION --}}
      <div class="flex shrink-0 items-center gap-2">

        {{-- SUPPRESSION MULTIPLE --}}
        <button
          type="button"
          id="deleteSelectedConversationsButton"
          aria-label="Supprimer les conversations sélectionnées"
          title="Supprimer les conversations sélectionnées"
          disabled
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-red-500 transition hover:bg-red-50 hover:text-red-600 disabled:cursor-not-allowed disabled:opacity-40"
        >
          <i
            class="fa-solid fa-trash-can text-base"
            aria-hidden="true"
          ></i>
        </button>

        {{-- ANNULER LA SÉLECTION --}}
        <button
          type="button"
          id="cancelConversationSelection"
          aria-label="Annuler la sélection"
          title="Annuler la sélection"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-200 hover:text-brand-blue"
        >
          <i
            class="fa-solid fa-xmark text-lg"
            aria-hidden="true"
          ></i>
        </button>

      </div>
    </div>

  </div>

  {{-- LISTE DES CONVERSATIONS --}}
  <div
    id="chatItems"
    class="min-h-0 flex-1 space-y-1 overflow-y-auto p-3 pb-[100px] md:pb-3"
    aria-live="polite"
  >
    <div
      id="conversationsLoading"
      class="p-4 text-center text-sm text-slate-500"
    >
      Chargement des conversations...
    </div>
  </div>
</section>

{{-- MODALE DE CONFIRMATION DE SUPPRESSION --}}
<div
  id="deleteConversationsConfirmModal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="deleteConversationsConfirmTitle"
  aria-describedby="deleteConversationsConfirmMessage"
>
  <div
    class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl"
  >

    {{-- EN-TÊTE DE LA MODALE --}}
    <div class="flex items-start gap-3 border-b border-slate-100 p-4 sm:p-5">

      {{-- ICÔNE --}}
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600"
        aria-hidden="true"
      >
        <i class="fa-solid fa-trash-can text-lg"></i>
      </div>

      {{-- TITRE ET MESSAGE --}}
      <div class="min-w-0 flex-1 pt-0.5">
        <h2
          id="deleteConversationsConfirmTitle"
          class="text-base font-bold leading-5 text-slate-900"
        >
          Supprimer la conversation
        </h2>

        <p
          id="deleteConversationsConfirmMessage"
          class="mt-1 break-words text-sm leading-5 text-slate-600"
        >
          Veux-tu vraiment supprimer cette conversation ? Cette action est irréversible.
        </p>
      </div>

      {{-- FERMER LA MODALE --}}
      <button
        type="button"
        id="closeDeleteConversationsConfirm"
        aria-label="Fermer la fenêtre"
        title="Fermer"
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
      >
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

    </div>

    {{-- MESSAGE D'ERREUR --}}
    <div class="px-4 pt-3 sm:px-5">
      <p
        id="deleteConversationsError"
        class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        role="alert"
        aria-live="assertive"
      ></p>
    </div>

    {{-- BOUTONS D'ACTION --}}
    <div class="flex flex-col-reverse gap-2 p-4 sm:flex-row sm:justify-end sm:p-5">

      {{-- ANNULER --}}
      <button
        type="button"
        id="cancelDeleteConversations"
        class="inline-flex min-h-10 items-center justify-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Annuler
      </button>

      {{-- CONFIRMER --}}
      <button
        type="button"
        id="confirmDeleteConversations"
        class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-60"
      >
        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
        <span>Supprimer</span>
      </button>

    </div>
  </div>
</div>