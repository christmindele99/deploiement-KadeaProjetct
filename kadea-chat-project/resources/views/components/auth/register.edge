<form 
    method="POST" 
    action="{{ route('register.store') }}" 
    class="space-y-4" 
    novalidate
>
    {{ csrfField() }}
    <div>
    <label 
        for="fullName" 
        class="block text-xs sm:text-sm font-medium text-white mb-1"
    >
        Nom complet
    </label>
    <input 
        type="text" 
        id="fullName" 
        name="fullName" 
        value="{{ old('fullName') ?? '' }}"
        placeholder="Entrez votre nom complet"
        class="w-full px-4 py-2.5 rounded-xl bg-white/10 border
        {{ flashMessages.has('errors.fullName') 
        ? 'border-red-400 focus:ring-red-400 focus:border-red-400' 
        : 'border-white/20 focus:ring-brand-accent focus:border-brand-accent' 
        }}
        text-white placeholder-gray-300
        focus:outline-none focus:ring-2
        transition duration-150 text-sm"
    >
    </div>
    <div>
        <label 
            for="email" 
            class="block text-xs sm:text-sm font-medium text-white mb-1">
            Email
        </label>
        <input 
            type="email" 
            id="email" 
            name="email" 
            value="{{ old('email') ?? '' }}"
            placeholder="votre@gmail.com"
            class="w-full px-4 py-2.5 rounded-xl bg-white/10 border
            {{ flashMessages.has('errors.email') 
            ? 'border-red-400 focus:ring-red-400 focus:border-red-400' 
            : 'border-white/20 focus:ring-brand-accent focus:border-brand-accent' 
            }}
            text-white placeholder-gray-300
            focus:outline-none focus:ring-2
            transition duration-150 text-sm"
        >
    </div>
    <div>
        <label 
            for="password" 
            class="block text-xs sm:text-sm font-medium text-white mb-1">
            Mot de passe
        </label>
        <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="••••••••"
            class="w-full px-4 py-2.5 rounded-xl bg-white/10 border
            text-white placeholder-gray-300
            focus:outline-none focus:ring-2
            transition duration-150 text-sm"
        >
    </div>
    <div>
        <label 
            for="passwordConfirmation" 
            class="block text-xs sm:text-sm font-medium text-white mb-1"
        >
            Confirmation mot de passe
        </label>
        <input 
            type="password" 
            id="passwordConfirmation" 
            name="passwordConfirmation" 
            placeholder="••••••••"
            class="w-full px-4 py-2.5 rounded-xl bg-white/10 border
            text-white placeholder-gray-300
            focus:outline-none focus:ring-2
            transition duration-150 text-sm"
        >
    </div>
    <button 
        type="submit" 
        class="w-full mt-3 bg-brand-accent hover:opacity-90
        text-brand-dark font-semibold py-3 px-4 rounded-xl
        shadow-lg transition duration-200 ease-in-out
        focus:outline-none focus:ring-2 focus:ring-brand-accent
        focus:ring-offset-2 focus:ring-offset-brand-blue
        active:scale-[0.99]"
        >
        S'inscrire
    </button>
</form>