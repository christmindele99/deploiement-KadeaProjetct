
<style>
    :root {
      color-scheme: light;
    }

    html.dark {
      color-scheme: dark;
    }

    * {
      scrollbar-width: thin;
      scrollbar-color: #cbd5e1 transparent;
    }

    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }

    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid #29ff9d;
      outline-offset: 2px;
    }

    /* Barre de défilement masquée */
    .no-scrollbar {
      scrollbar-width: none;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .font-artega {
      font-family: 'Artega', sans-serif;
    }

    .nav-item.is-active {
      background-color: #29ff9d;
      color: #000000;
    }

    .mobile-nav-item.is-active {
      background-color: rgba(41, 255, 157, .18);
      color: #075e8d;
    }

    .mobile-new-chat.is-active {
      background-color: #29ff9d;
      color: #075e8d;
    }

    .filter-button {
      background-color: #075e8d;
      color: #ffffff;
    }

    .filter-button:hover {
      background-color: #064b70;
      color: #ffffff;
    }

    .filter-button.is-active {
      background-color: #29ff9d;
      color: #075e8d;
      font-weight: 600;
    }

    .filter-button.is-active:hover {
      background-color: #29ff9d;
      color: #075e8d;
    }

    .chat-item.is-active {
      background-color: #eff6ff;
      border-left-color: #075e8d;
    }

    html.dark,
    .dark body {
      background-color: #111827;
      color: #f9fafb;
    }

    .dark .app-surface {
      background-color: #111827;
      color: #f9fafb;
    }

    .dark .app-panel {
      background-color: #1f2937;
      border-color: #374151;
    }

    .dark .app-text,
    .dark .text-brand-blue {
      color: #f9fafb;
    }

    .dark .app-muted {
      color: #9ca3af;
    }

    .dark .app-input {
      background-color: #111827;
      color: #f9fafb;
      border-color: #374151;
    }

    .dark .app-input::placeholder {
      color: #9ca3af;
    }

    .dark .received-message {
      background-color: #374151;
      color: #f9fafb;
    }

    .dark .chat-item.is-active {
      background-color: #183449;
      border-left-color: #29ff9d;
    }

    .dark .filter-button {
      background-color: #075e8d;
      color: #ffffff;
    }

    .dark .filter-button:hover {
      background-color: #064b70;
      color: #ffffff;
    }

    .dark .filter-button.is-active,
    .dark .filter-button.is-active:hover {
      background-color: #29ff9d;
      color: #075e8d;
    }

    .dark .mobile-nav-item {
      color: #f9fafb;
    }

    .dark .mobile-nav-item.is-active {
      background-color: rgba(41, 255, 157, .15);
      color: #29ff9d;
    }

    .dark .nav-item.is-active {
      background-color: #29ff9d;
      color: #000000;
    }

    .dark .border-slate-200 {
      border-color: #374151;
    }

    .dark .bg-white {
      background-color: #1f2937;
    }

    .dark .bg-slate-50 {
      background-color: #273548;
    }

    .dark .bg-slate-100 {
      background-color: #374151;
    }

    .dark .text-slate-500,
    .dark .text-slate-400 {
      color: #9ca3af;
    }

    .dark .text-white {
      color: #ffffff;
    }

    @supports (backdrop-filter: blur(16px)) {
      .dark .mobile-glass {
        background-color: rgba(31, 41, 55, .88);
      }
    }


    /* ===== THÈME SOMBRE ===== */
    html.dark body,
    html.dark #app,
    html.dark .bg-white { background-color: #212121 !important; }

    html.dark .bg-white\/90 { background-color: rgba(33, 33, 33, 0.9) !important; }

    /* Blocs gris : pastilles d'icônes, survols, zones claires */
    html.dark .bg-sky-50,
    html.dark .bg-emerald-50,
    html.dark .bg-slate-50,
    html.dark .hover\:bg-emerald-50:hover { background-color: #444444 !important; }

    /* Survol : gris transparent */
    html.dark .hover\:bg-emerald-50:hover,
    html.dark .hover\:bg-slate-50:hover,
    html.dark .hover\:bg-slate-100:hover,
    html.dark .hover\:bg-gray-50:hover,
    html.dark .hover\:bg-white:hover { background-color: rgba(255, 255, 255, 0.08) !important; }

    html.dark .hover\:bg-red-100:hover { background-color: rgba(239, 68, 68, 0.15) !important; }

    html.dark .border-slate-200,
    html.dark .border-emerald-100 { border-color: #383838 !important; }

    /* Éléments posés sur le gris : en blanc */
    html.dark .text-brand-blue,
    html.dark .bg-sky-50 i,
    html.dark .bg-emerald-50 i { color: #ffffff !important; }

    /* Grands titres en blanc */
    html.dark h1,
    html.dark h2,
    html.dark h3,
    html.dark h1.text-brand-blue,
    html.dark h2.text-brand-blue,
    html.dark h3.text-brand-blue { color: #ffffff !important; }

    /* Textes secondaires */
    html.dark .text-slate-500,
    html.dark .text-slate-400 { color: #ffffff !important; }

    /* Bouton de déconnexion */
    html.dark .bg-red-50 { background-color: #3a1f22 !important; }
    html.dark .border-red-200 { border-color: #5c2b30 !important; }

    /* Tout ce qui est bleu devient vert */
    html.dark .bg-brand-blue,
    html.dark .bg-sky-500,
    html.dark .bg-sky-600,
    html.dark .bg-sky-700 { background-color: #10b981 !important; }

    html.dark .hover\:bg-sky-800:hover,
    html.dark .hover\:bg-sky-700:hover,
    html.dark .hover\:bg-sky-600:hover { background-color: #059669 !important; }

    html.dark .border-brand-blue,
    html.dark .border-sky-500,
    html.dark .border-sky-600 { border-color: #10b981 !important; }

    html.dark .text-sky-500,
    html.dark .text-sky-600,
    html.dark .text-sky-700 { color: #10b981 !important; }

    html.dark .shadow-\[0_5px_14px_rgba\(7\,94\,141\,0\.25\)\] { box-shadow: 0 5px 14px rgba(16, 185, 129, 0.25) !important; }

    html.dark .focus-visible\:outline-brand-accent:focus-visible { outline-color: #10b981 !important; }

    /* La boule du switch reste verte */
    html.dark #themeSwitch span { background-color: #10b981 !important; }
    html.dark #themeSwitch { background-color: #3a3a3a !important; }
    /* Confidentialité : titres des cartes en vert */
html.dark h4,
html.dark h4.text-brand-blue { color: #10b981 !important; }

/* Confidentialité : contenu des cartes en blanc */
html.dark main button,
html.dark main button i,
html.dark main .text-amber-700 { color: #ffffff !important; }

html.dark .bg-amber-50 { background-color: #444444 !important; }
html.dark .border-amber-200,
html.dark .border-slate-100 { border-color: #383838 !important; }

/* Noms des utilisateurs dans les listes (nouvelle conversation, groupes) en vert */
html.dark #newChatContacts .text-brand-blue,
html.dark #newChatContacts .font-semibold,
html.dark #groupMembersList .text-brand-blue,
html.dark #groupMembersList .font-semibold,
html.dark #groupInfoMembers .text-brand-blue,
html.dark #groupInfoMembers .font-semibold { color: #10b981 !important; }
/* Confidentialité : explications des cartes en blanc */
html.dark main p,
html.dark main span,
html.dark main label,
html.dark main li,
html.dark main .text-slate-600,
html.dark main .text-slate-700,
html.dark main .text-slate-800,
html.dark main .text-slate-900,
html.dark main .text-\[\#075e8d\] { color: #ffffff !important; }
/* Profil : premier bloc en bleu */
html.dark main div.bg-brand-blue { background-color: #075e8d !important; }

html.dark main div.bg-brand-blue p,
html.dark main div.bg-brand-blue span { color: #dbeafe !important; }

/* Profil : nom complet en vert */
html.dark main #profileFullName { color: #10b981 !important; }
/* Badge "Compte vérifié" : conteneur vert, texte blanc */
html.dark main form span.bg-emerald-50 {
  background-color: #10b981 !important;
  border-color: #10b981 !important;
}

html.dark main form span.bg-emerald-50,
html.dark main form span.bg-emerald-50 i { color: #ffffff !important; }
/* Commentaire : nom du compte en vert */
html.dark #commentUserName { color: #10b981 !important; }

/* Confidentialité : "Modifier le mot de passe" en gris */
html.dark #changePasswordButton {
  background-color: #444444 !important;
  border-color: #383838 !important;
}

/* Confidentialité : "Réinitialiser le mot de passe" en vert transparent */
html.dark #resetPasswordButton {
  background-color: rgba(16, 185, 129, 0.35) !important;
  border-color: #10b981 !important;
}

html.dark #resetPasswordButton:hover { background-color: rgba(16, 185, 129, 0.5) !important; }
  </style>