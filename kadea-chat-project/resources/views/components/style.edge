
<style>
    :root {
      color-scheme: light;
    }

    html.dark {
      color-scheme: dark;
    }

    * {
      scrollbar-width: thin;
      scrollbar-color: #cbd5e1 transparent;
    }

    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }

    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 2px solid #29ff9d;
      outline-offset: 2px;
    }

    /* Barre de défilement masquée */
    .no-scrollbar {
      scrollbar-width: none;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }

    .font-artega {
      font-family: 'Artega', sans-serif;
    }

    .nav-item.is-active {
      background-color: #29ff9d;
      color: #000000;
    }

    .mobile-nav-item.is-active {
      background-color: rgba(41, 255, 157, .18);
      color: #075e8d;
    }

    .mobile-new-chat.is-active {
      background-color: #29ff9d;
      color: #075e8d;
    }

    .filter-button {
      background-color: #075e8d;
      color: #ffffff;
    }

    .filter-button:hover {
      background-color: #064b70;
      color: #ffffff;
    }

    .filter-button.is-active {
      background-color: #29ff9d;
      color: #075e8d;
      font-weight: 600;
    }

    .filter-button.is-active:hover {
      background-color: #29ff9d;
      color: #075e8d;
    }

    .chat-item.is-active {
      background-color: #eff6ff;
      border-left-color: #075e8d;
    }

    html.dark,
    .dark body {
      background-color: #111827;
      color: #f9fafb;
    }

    .dark .app-surface {
      background-color: #111827;
      color: #f9fafb;
    }

    .dark .app-panel {
      background-color: #1f2937;
      border-color: #374151;
    }

    .dark .app-text,
    .dark .text-brand-blue {
      color: #f9fafb;
    }

    .dark .app-muted {
      color: #9ca3af;
    }

    .dark .app-input {
      background-color: #111827;
      color: #f9fafb;
      border-color: #374151;
    }

    .dark .app-input::placeholder {
      color: #9ca3af;
    }

    .dark .received-message {
      background-color: #374151;
      color: #f9fafb;
    }

    .dark .chat-item.is-active {
      background-color: #183449;
      border-left-color: #29ff9d;
    }

    .dark .filter-button {
      background-color: #075e8d;
      color: #ffffff;
    }

    .dark .filter-button:hover {
      background-color: #064b70;
      color: #ffffff;
    }

    .dark .filter-button.is-active,
    .dark .filter-button.is-active:hover {
      background-color: #29ff9d;
      color: #075e8d;
    }

    .dark .mobile-nav-item {
      color: #f9fafb;
    }

    .dark .mobile-nav-item.is-active {
      background-color: rgba(41, 255, 157, .15);
      color: #29ff9d;
    }

    .dark .nav-item.is-active {
      background-color: #29ff9d;
      color: #000000;
    }

    .dark .border-slate-200 {
      border-color: #374151;
    }

    .dark .bg-white {
      background-color: #1f2937;
    }

    .dark .bg-slate-50 {
      background-color: #273548;
    }

    .dark .bg-slate-100 {
      background-color: #374151;
    }

    .dark .text-slate-500,
    .dark .text-slate-400 {
      color: #9ca3af;
    }

    .dark .text-white {
      color: #ffffff;
    }

    @supports (backdrop-filter: blur(16px)) {
      .dark .mobile-glass {
        background-color: rgba(31, 41, 55, .88);
      }
    }
  </style>